# Fine-grained GitHub token used only by the server.
# Required for dispatch / cancel / rerun and recommended for realtime polling.
GITHUB_TOKEN=

# Optional. Configure this only when GitHub can reach your Forge HTTPS endpoint.
# The same value must be used as the GitHub Webhook secret.
GITHUB_WEBHOOK_SECRET=

# Polling fallback when Webhook is unavailable.
# Default: 12000 with GITHUB_TOKEN, 300000 without token. Minimum: 5000.
# RUN_POLL_INTERVAL_MS=12000

PORT=3001
HOST=0.0.0.0
# DATA_DIR=./data
