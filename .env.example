# Recommended: GitHub OAuth login.
# Create a GitHub OAuth App and set the Client ID here.
# With only Client ID configured, Nowen Forge uses GitHub Device Flow.
GITHUB_OAUTH_CLIENT_ID=

# Optional. When configured together with Client ID, Forge uses browser Web OAuth
# for a direct GitHub login experience. Keep this server-side only.
GITHUB_OAUTH_CLIENT_SECRET=

# Optional fixed callback URL for NAS / reverse proxy / public-domain deployments.
# Example: https://forge.example.com/api/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=

# Optional OAuth scopes. Defaults to: repo workflow read:user
# GITHUB_OAUTH_SCOPES=repo workflow read:user

# Optional fallback for unattended/server deployments.
# OAuth login takes priority when a user has logged in.
GITHUB_TOKEN=

# Optional. Configure this only when GitHub can reach your Forge HTTPS endpoint.
# The same value must be used as the GitHub Webhook secret.
GITHUB_WEBHOOK_SECRET=

# V0.7: Gitee final-platform verification for Nowen Note.
# These may reuse the same values as nowen-note repository Actions secrets.
GITEE_TOKEN=
GITEE_OWNER=cropflre
GITEE_REPO=nowen-note

# V0.7: App Store Connect / TestFlight final-platform verification.
# Team API key credentials; keep the private key server-side only.
APPSTORE_ISSUER_ID=
APPSTORE_API_KEY_ID=
# Paste the .p8 key as multiline PEM, or use literal \n escapes in a single-line env value.
APPSTORE_API_PRIVATE_KEY=
APPSTORE_BUNDLE_ID=com.nowen.note

# Polling fallback when Webhook is unavailable.
# Authenticated GitHub reads are cached aggressively; anonymous reads use a longer 5-minute cache.
# Default watcher interval: 12000 ms. Minimum: 5000.
# RUN_POLL_INTERVAL_MS=12000

PORT=18667
HOST=0.0.0.0
# DATA_DIR=./data
